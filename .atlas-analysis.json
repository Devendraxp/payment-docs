  "keyFeatures": [
    "Multi-gateway payment routing with intelligent scoring across success rate, latency, method affinity, bank affinity, and amount tiers",
    "Circuit breaker protection with CLOSED / HALF_OPEN / OPEN states per gateway-method pair",
    "Idempotency enforcement via idempotency-key header to prevent duplicate charges",
    "Per-merchant retry policies with configurable max attempts, latency budget, and timeout retry behavior",
    "A/B experimentation framework with deterministic customer assignment and control/treatment gateway ordering",
    "Thompson Sampling bandit optimization for continuous gateway order learning per payment segment",
    "Real-time hot metrics (5-minute sliding window) and persisted metric history per gateway",
    "Asynchronous payment verification via RabbitMQ for timeout-state payments",
    "Rate limiting at 100 requests per minute per IP on payment creation",
    "Support for UPI, CARD, NETBANKING, and WALLET payment methods"
  ],
  "publicApiSurface": [
    "POST /payments",
    "GET /payments/{paymentId}",
    "GET /payments/{paymentId}/attempts",
    "GET /payments/{paymentId}/routing-decision",
    "GET /payments/{paymentId}/status-verification",
    "GET /gateways",

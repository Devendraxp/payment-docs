    "PATCH /gateways/{gatewayName}",
    "GET /scoring/debug",
    "GET /circuit-breaker/status",
    "POST /circuit-breaker/force-open/{gatewayName}/{method}",
    "POST /circuit-breaker/force-close/{gatewayName}/{method}",
    "GET /retry-policy",
    "GET /retry-policy/{merchantId}",
    "PUT /retry-policy/{merchantId}",
    "GET /metrics/gateways",
